<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS LaunchAgent: run the nightly retrain at 00:00. Copy to
     ~/Library/LaunchAgents/com.minilogue.nightly-retrain.plist then `launchctl load` it
     (see scripts/nightly-retrain.README.md). A LaunchAgent runs in your login session, so it
     can see user-mounted volumes like /Volumes/Samples (a LaunchDaemon / cron often can't).
     If the Mac is asleep at midnight, launchd runs the job at the next wake. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minilogue.nightly-retrain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ava/Developer/minilogue-viewer/scripts/nightly-retrain.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/ava/Developer/minilogue-viewer/training/.nightly.cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ava/Developer/minilogue-viewer/training/.nightly.cron.log</string>
</dict>
</plist>
